generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  calls         Call[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Call {
  id                 String    @id @default(cuid())
  status             String    @default("preparing")
  companyName        String
  companyUrl         String?
  supportPhone       String
  problemDescription String
  customerName       String
  orderNumber        String?
  language           String    @default("en")
  fileUrl            String?

  userId             String?
  user               User?     @relation(fields: [userId], references: [id])

  tosData            Json?
  redditTips         Json?     // String[]
  consumerRights     Json?     // String[]
  arguments          Json?     // Argument[]
  prepSteps          Json?     // PrepStep[]
  strategy           String?
  missingInfo        Json?     // { sufficient: boolean, questions: MissingInfoQuestion[] }
  additionalInfo     Json?     // Record<string, string> — user answers to missing info questions

  agentId            String?
  conversationId     String?

  resultType         String?
  resultAmount       Float?
  resultCurrency     String?
  operatorName       String?
  referenceNumber    String?
  resultSummary      String?

  audioUrl           String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  callStartedAt      DateTime?
  callEndedAt        DateTime?

  transcript         TranscriptMessage[]
  clientQuestions    ClientQuestion[]

  @@index([userId])
}

model TranscriptMessage {
  id        String  @id @default(cuid())
  callId    String
  call      Call    @relation(fields: [callId], references: [id], onDelete: Cascade)
  speaker   String
  text      String
  timestamp Float
  citedTos  Boolean @default(false)

  @@index([callId])
}

model ClientQuestion {
  id         String    @id @default(cuid())
  callId     String
  call       Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([callId])
}
